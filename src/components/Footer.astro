    &copy; {today.getFullYear()} Hoàng Thắng
  </div>
  <div class="inline opacity-70 text-sm">
    Xây dựng với Astro & TailwindCSS ·
    <a
      href="https://github.com/manuelernestog/astrofy"
      target="_blank"
      rel="noreferrer"
      class="font-semibold"
    >
      Based on Astrofy
    </a>
  </div>
</footer>
