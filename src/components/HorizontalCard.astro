---
const { title, img, desc, url, badge, tags, target = "_blank" } = Astro.props;
import { Image } from "astro:assets";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const withBase = (path: string) => `${base}/${path.replace(/^\/+/, "")}`;
const resolvedImg = img && !/^https?:\/\//i.test(img) && img.startsWith("/") ? withBase(img) : img;
---
<article class="rounded-lg bg-base-100 border border-base-200 my-3 p-4">
  <div class="flex flex-col md:flex-row gap-5">
    {resolvedImg && <Image src={resolvedImg} width={750} height={422} format="webp" alt="" class="max-w-full md:max-w-[13rem] rounded-lg object-cover" />}
    <div class="grow w-full">
      <h2 class="text-xl font-bold"><a href={url} target={target} rel={target === "_blank" ? "noopener noreferrer" : undefined} class="hover:underline">{title}</a></h2>
      {badge && <span class="badge badge-outline my-2">{badge}</span>}
      <p class="py-1">{desc}</p>
      {tags && <div class="flex flex-wrap gap-2 mt-3">{tags.map((tag: string) => <a href={withBase(`blog/tag/${tag}/`)} class="badge badge-outline">{tag}</a>)}</div>}
    </div>
  </div>
</article>
