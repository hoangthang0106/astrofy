---
const { sideBarActiveItemID } = Astro.props;
const activeClass = "bg-base-300";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const withBase = (path: string) => `${base}/${path.replace(/^\/+/, "")}`;
---

<ul class="menu grow shrink menu-md overflow-y-auto">
  <li><a class="py-3 text-base" id="home" href={withBase("/")}>Trang chủ</a></li>
  <li><a class="py-3 text-base" id="projects" href={withBase("/projects")}>Lĩnh vực</a></li>
  <li><a class="py-3 text-base" id="blog" href={withBase("/blog/")}>Ghi chú</a></li>
  <li><a class="py-3 text-base" id="cv" href={withBase("/cv")}>Về tôi</a></li>
  <li>
    <a class="py-3 text-base" href="https://github.com/hoangthang0106" target="_blank" rel="noreferrer">
      GitHub
    </a>
  </li>
</ul>

<script define:vars={{ sideBarActiveItemID, activeClass }}>
  const activeItemElem = document.getElementById(sideBarActiveItemID);
  activeItemElem && activeItemElem.classList.add(activeClass);
</script>
