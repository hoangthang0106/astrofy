---
import BaseLayout from "../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const homeUrl = `${base}/`;
---

<BaseLayout title="404 - Không tìm thấy trang" includeSidebar={false}>
  <div class="text-center">
    <h1 class="text-8xl font-bold mb-4">404</h1>
    <h2 class="text-2xl">Không tìm thấy trang bạn yêu cầu.</h2>
    <a class="btn btn-accent mt-9" href={homeUrl}>Về trang chủ</a>
  </div>
</BaseLayout>
