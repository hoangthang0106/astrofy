---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import createSlug from "../lib/createSlug";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const link = (path: string) => `${base}/${path.replace(/^\/+/, "")}`;
const posts = (await getCollection("blog")).sort((a,b) => b.data.pubDate.valueOf()-a.data.pubDate.valueOf()).slice(0,3);
const areas = [
  ["01", "Hạ tầng & hệ thống mạng", "Vận hành mạng doanh nghiệp, VLAN, Wi-Fi, firewall và dịch vụ máy chủ.", "MikroTik · Cisco · UniFi"],
  ["02", "Quản lý & hỗ trợ IT", "Quản lý tài sản, hỗ trợ người dùng và chuẩn hóa tài liệu vận hành.", "GLPI · Windows · Microsoft 365"],
  ["03", "Camera & lưu trữ", "Làm việc với camera IP, đầu ghi, NAS và các nhu cầu sao lưu dữ liệu.", "Hikvision · Synology · PoE"],
  ["04", "Homelab & tự động hóa", "Thử nghiệm dịch vụ tự host và tìm cách giảm những thao tác lặp lại.", "Proxmox · Docker · API"],
];
---
<BaseLayout sideBarActiveItemID="home">
  <section class="profile-hero" aria-labelledby="intro-title">
    <p class="eyebrow">GÓC CÁ NHÂN · CÔNG NGHỆ & CÔNG VIỆC</p>
    <h1 id="intro-title">Hoàng Quốc Thắng<span>IT từ công việc đến homelab.</span></h1>
    <p class="hero-summary">Tôi làm việc trong lĩnh vực công nghệ thông tin, tập trung vào hạ tầng mạng, máy chủ và hỗ trợ người dùng. Đây là nơi tôi giới thiệu bản thân và chia sẻ những ghi chú trong quá trình làm việc, học hỏi.</p>
    <div class="hero-actions">
      <a class="btn btn-neutral" href={link("cv")}>Về tôi <span aria-hidden="true">↗</span></a>
      <a class="btn btn-outline" href={link("blog/")}>Đọc ghi chú</a>
    </div>
    <div class="hero-footnote">Hạ tầng CNTT / Hỗ trợ kỹ thuật / Tự động hóa</div>
  </section>
  <section class="profile-section" aria-labelledby="areas-title">
    <div class="section-heading"><div><p class="eyebrow">CÔNG VIỆC & MỐI QUAN TÂM</p><h2 id="areas-title">Những lĩnh vực tôi tập trung</h2></div><a href={link("projects")}>Xem thêm →</a></div>
    <div class="area-grid">{areas.map(([number,title,description,tools]) => <article class="area-card"><span class="area-number">{number}</span><h3>{title}</h3><p>{description}</p><small>{tools}</small></article>)}</div>
  </section>
  <section class="profile-section" aria-labelledby="notes-title">
    <div class="section-heading"><div><p class="eyebrow">CHIA SẺ & HỌC HỎI</p><h2 id="notes-title">Ghi chú kỹ thuật</h2></div><a href={link("blog/")}>Tất cả bài viết →</a></div>
    <div class="note-list">{posts.map(post => <a class="note-row" href={link("blog/"+createSlug(post.data.title,post.slug))}><div><span class="note-topic">{post.data.badge}</span><h3>{post.data.title}</h3><p>{post.data.description}</p></div><span aria-hidden="true">↗</span></a>)}</div>
  </section>
  <section class="contact-strip"><div><p class="eyebrow">KẾT NỐI</p><h2>Cùng trao đổi về công nghệ.</h2><p>Các dự án và mã nguồn công khai của tôi có trên GitHub.</p></div><a class="btn btn-neutral" href="https://github.com/hoangthang0106" target="_blank" rel="noopener noreferrer">GitHub ↗</a></section>
</BaseLayout>
